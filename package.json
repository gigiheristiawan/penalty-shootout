{
  "name": "penalty-shootout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "esbuild tools/sim.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/sim.mjs && node tools/.out/sim.mjs",
    "sim:probe": "esbuild tools/probe.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/probe.mjs && node tools/.out/probe.mjs",
    "sim:stability": "esbuild tools/stability.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/stability.mjs && node tools/.out/stability.mjs",
    "sim:keeper": "esbuild tools/dumb.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/dumb.mjs && node tools/.out/dumb.mjs",
    "sim:deflection": "esbuild tools/deflection.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/deflection.mjs && node tools/.out/deflection.mjs",
    "sim:woodwork": "esbuild tools/woodwork.ts --bundle --platform=node --format=esm --main-fields=module,main --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=tools/.out/woodwork.mjs && node tools/.out/woodwork.mjs",
    "e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
